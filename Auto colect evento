-- o jogo só deixa resgatar 1 presente de cada tipo
local function giftTaken(cat)
    if giftDone[cat] then return true end
    -- diagnóstico: ao resgatar, o jogador ganha o atributo GamepassGiftCollects=1
    -- (o de patente segue o padrão Gift sem "gamepass" no nome)
    for n, v in pairs(lp:GetAttributes()) do
        local l = n:lower()
        if l:find("gift", 1, true) and type(v) == "number" and v >= 1 then
            local isGP = l:find("gamepass", 1, true) ~= nil
            if (cat == "Gamepass") == isGP then return true end
        end
    end
    return false
end
task.spawn(function()
