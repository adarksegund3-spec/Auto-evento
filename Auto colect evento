end

local function closeMenu()
    if busy or mini then return end
    busy, mini = true, true
    setOpen(false)
    tween(content, 0.2, { GroupTransparency = 1 })
    task.wait(0.2)
    content.Visible = false
    curW, curH = MINI_W, MINI_H
