        local sel = (key == "Todos") and State.UmDeCada or State.Selecionados[key]
        tween(r.row, 0.2, { BackgroundTransparency = sel and 0.88 or 1 })
        tween(r.pill, 0.2, { BackgroundColor3 = sel and T.blue or T.pill })
        tween(r.knob, 0.22, {
            Position = sel and UDim2.fromOffset(21, 3) or UDim2.fromOffset(3, 3),
            BackgroundColor3 = sel and WHITE or T.sub,
        }, Enum.EasingStyle.Back)
        tween(r.lb, 0.2, { TextColor3 = sel and T.blue or T.text })
    end

    local names = {}
    for _, c in ipairs(CHIPS) do
        if State.Selecionados[c[1]] then table.insert(names, c[1] == "UpPatente" and "Up patente" or c[2]) end
    end
    summary.Text = State.UmDeCada and "Todos (1 de cada)" or (#names > 0 and table.concat(names, ", ") or "Selecione...")
