local function tpTo(pos)
    local r = hrp()
    if not r then return end
    r.CFrame = CFrame.new(pos)
    pcall(function() r.AssemblyLinearVelocity = Vector3.zero end)
end
local function frame() RunService.Heartbeat:Wait() end

-- teleporta em cima, aciona NO MESMO FRAME e confirma frame a frame; ao pegar, já retorna pro próximo
local function collect(o, cat)
    currentCat = cat
    if cat ~= "Dinheiro" and suspect(o) then
        for _ = 1, 6 do
            for _, pr in ipairs(promptsOf(o)) do
                pcall(function()
                    pr.HoldDuration = 0
                    pr.MaxActivationDistance = 1e6
                    if fireproximityprompt then fireproximityprompt(pr) end
                end)
            end
            task.wait(0.05)
            if giftTaken(cat) then return true end
        end
        blacklist[o] = os.clock() + 90
        return false
    end
    local t0 = os.clock()
    local fired = false
    while o.Parent and State.Ativo and os.clock() - t0 < 2 do
        local p = posOf(o) -- presentes caem do céu: acompanha a posição atual
        if p then tpTo(p + Vector3.new(0, 5, 0)) end
        for _, pr in ipairs(promptsOf(o)) do
            if pr.Enabled then
                fired = true
                pcall(function() pr.HoldDuration = 0 end)
                pcall(function()
                    if fireproximityprompt then
                        fireproximityprompt(pr)
                    else
                        pr:InputHoldBegin()
                        pr:InputHoldEnd()
                    end
                end)
            end
        end
        frame()
        if not o.Parent then return true end
        if cat ~= "Dinheiro" and giftTaken(cat) then return true end
        if not fired and os.clock() - t0 > 0.3 then break end
    end
    if o.Parent then
        blacklist[o] = os.clock() + 4
        return false
    end
    return true
end

local homeCF
local function farmLoop(token)
    while State.Ativo and farmToken == token and gui.Parent do
        local picks = {}
        for _, cat in ipairs(PRIORITY) do
            if Allowed[cat] and (State.UmDeCada or State.Selecionados[cat]) then
                local l = sortByDist(listTargets(cat))
                if l[1] then
                    picks[#picks + 1] = { l[1], cat }
                    if not State.UmDeCada then break end
                end
            end
        end
        if #picks == 0 or not hrp() then
            local onlyGifts, taken = true, true
            for _, cat in ipairs(PRIORITY) do
                if Allowed[cat] and (State.UmDeCada or State.Selecionados[cat]) then
                    if cat == "Dinheiro" then onlyGifts = false
                    elseif not giftTaken(cat) then taken = false end
                end
            end
            radar.Text = (onlyGifts and taken) and "Radar de drops · presente já resgatado" or "Radar de drops · procurando drops..."
            local r = hrp()
            if r and homeCF and (r.Position - homeCF.Position).Magnitude > 25 then
                r.CFrame = homeCF
                pcall(function() r.AssemblyLinearVelocity = Vector3.zero end)
            end
            task.wait(0.15)
        else
            for _, pk in ipairs(picks) do
                if not (State.Ativo and farmToken == token) then break end
                if pk[1].Parent then
                    radar.Text = "Radar de drops · coletando " .. (pk[1].Name:gsub("_", " "))
                    collect(pk[1], pk[2])
                end
            end
            frame()
        end
    end
end

local function startFarm()
    local r = hrp()
    homeCF = r and r.CFrame or nil
    giftDone = {}
    farmToken = farmToken + 1
    task.spawn(farmLoop, farmToken)
end
local function stopFarm()
    farmToken = farmToken + 1
end

