    miniGrp.Visible = true
    tween(miniGrp, 0.35, { GroupTransparency = 0 })
    busy = false
end

local function openMenu()
    if busy or not mini then return end
    busy, mini = true, false
    tween(miniGrp, 0.15, { GroupTransparency = 1 })
