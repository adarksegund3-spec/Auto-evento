    end
    if open then setOpen(false) end
    for c in pairs(Allowed) do Allowed[c] = true end
    for c in pairs(State.Selecionados) do State.Selecionados[c] = false end
    State.UmDeCada = false
    buildRows()
    refresh()
    admInfo.Text = "Dropdown restaurado (Up patente, Gamepass, Dinheiro)."
    admInfo.TextColor3 = T.sub
end)
setApplyEnabled(false)

