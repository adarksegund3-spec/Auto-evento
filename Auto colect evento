local rows = {}
local function countAllowed()
    local n = 0
    for _, v in pairs(Allowed) do if v then n = n + 1 end end
    return n
end
local function toggle(key)
    if key == "Todos" then
        State.UmDeCada = not State.UmDeCada
        if State.UmDeCada then
            for k in pairs(State.Selecionados) do State.Selecionados[k] = false end
        end
    else
        State.Selecionados[key] = not State.Selecionados[key]
        if State.Selecionados[key] then State.UmDeCada = false end
    end
    if not (State.UmDeCada or State.Selecionados.UpPatente or State.Selecionados.Gamepass or State.Selecionados.Dinheiro) then
        State.Ativo = false
    end
end

