-- nomes dos drops por categoria (Gamepass entra depois do diagnóstico)
local CATS = {
    UpPatente = { "Presente_UpPatente" },
    Gamepass = {},
    Dinheiro = { "MoneyBag" },
}
local farmToken = 0
local blacklist = {}

local function hrp()
    local c = lp.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function posOf(o)
    local p
    pcall(function() p = o:IsA("Model") and o:GetPivot().Position or o.Position end)
    return p
end
local function listTargets(cat)
    local out = {}
    local names = CATS[cat]
    if not names or #names == 0 then return out end
    for _, o in ipairs(workspace:GetChildren()) do
        if o:IsA("BasePart") or o:IsA("Model") then
            for _, n in ipairs(names) do
                if o.Name == n and (not blacklist[o] or blacklist[o] < os.clock()) then
                    out[#out + 1] = o
                    break
                end
            end
        end
    end
    return out
end
local function sortByDist(list)
    local r = hrp()
    if not r then return list end
    table.sort(list, function(a, b)
        local pa, pb = posOf(a), posOf(b)
        return pa and pb and (pa - r.Position).Magnitude < (pb - r.Position).Magnitude or false
    end)
    return list
end

local function tpTo(pos)
    local r = hrp()
    if not r then return end
    r.CFrame = CFrame.new(pos)
    pcall(function() r.AssemblyLinearVelocity = Vector3.zero end)
end

local function promptsOf(o)
    local list = {}
    for _, x in ipairs(o:GetDescendants()) do
        if x:IsA("ProximityPrompt") then list[#list + 1] = x end
    end
    return list
end

-- teleporta em cima, clica várias vezes rápido e já segue para o próximo
local function collect(o)
    local p = posOf(o)
    if not p then return false end
    local spot = p + Vector3.new(0, 2.5, 0)
    local t0 = os.clock()
    while o.Parent and State.Ativo and os.clock() - t0 < 1.5 do
        tpTo(spot)
        for _, pr in ipairs(promptsOf(o)) do
            if pr.Enabled then
                pcall(function() pr.HoldDuration = 0 end)
                pcall(function()
                    if fireproximityprompt then
                        fireproximityprompt(pr)
                    else
                        pr:InputHoldBegin()
                        pr:InputHoldEnd()
                    end
                end)
            end
        end
        task.wait(0.06)
    end
    if o.Parent then
        blacklist[o] = os.clock() + 4
        return false
    end
    return true
end

local function farmLoop(token)
    while State.Ativo and farmToken == token and gui.Parent do
        local picks = {}
        if State.UmDeCada then
            for cat in pairs(CATS) do
                local l = sortByDist(listTargets(cat))
                if l[1] then picks[#picks + 1] = l[1] end
            end
            sortByDist(picks)
        else
            local all = {}
            for cat, on in pairs(State.Selecionados) do
                if on then
                    for _, o in ipairs(listTargets(cat)) do all[#all + 1] = o end
                end
            end
            sortByDist(all)
            if all[1] then picks[1] = all[1] end
        end
        if #picks == 0 or not hrp() then
            radar.Text = "Radar de drops · procurando drops..."
            task.wait(0.6)
        else
            for _, o in ipairs(picks) do
                if not (State.Ativo and farmToken == token) then break end
                if o.Parent then
                    radar.Text = "Radar de drops · coletando " .. o.Name:gsub("_", " ")
                    collect(o)
                end
            end
        end
    end
end

local function startFarm()
    farmToken = farmToken + 1
    task.spawn(farmLoop, farmToken)
end
local function stopFarm()
    farmToken = farmToken + 1
end

