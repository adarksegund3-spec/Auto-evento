local rootScale = make("UIScale", {}, holder)

local function fitScale()
    local v = gui.AbsoluteSize
    return math.clamp(math.min(v.X / 340, v.Y / 470), 0.65, 1)
end
local cur = { x = gui.AbsoluteSize.X / 2, y = math.max(20, gui.AbsoluteSize.Y / 2 - H_CLOSED / 2) }
local function place()
    local s, v = rootScale.Scale, gui.AbsoluteSize
    cur.x = math.clamp(cur.x, curW * s / 2, math.max(curW * s / 2, v.X - curW * s / 2))
    cur.y = math.clamp(cur.y, 0, math.max(0, v.Y - curH * s))
    holder.Position = UDim2.fromOffset(cur.x, cur.y)
end
