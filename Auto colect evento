local Rec = { on = false, hits = {}, seen = {}, conns = {}, onUpdate = nil }
local CAT_LIST = { "UpPatente", "Gamepass", "Dinheiro" }
local function recReset()
    Rec.hits = {}
    for _, c in ipairs(CAT_LIST) do Rec.hits[c] = { n = 0, names = {} } end
    Rec.seen = {}
end
recReset()

local function catOfText(t)
    t = tostring(t or ""):lower()
    if t:find("gamepass", 1, true) or t:find("game pass", 1, true) then return "Gamepass" end
    if t:find("patente", 1, true) or t:find("rank", 1, true) or t:find("promo", 1, true) then return "UpPatente" end
    if hasWord(t, MONEY_WORDS) then return "Dinheiro" end
    return nil
end
local function recHit(cat, name, key)
    if not Rec.on or not cat or not Rec.hits[cat] then return end
    if key then
        if Rec.seen[key] then return end
        Rec.seen[key] = true
    end
    local h = Rec.hits[cat]
    h.n = h.n + 1
    if name then h.names[name] = true end
    if Rec.onUpdate then pcall(Rec.onUpdate) end
end
local function strs(v, out, depth)
    if type(v) == "string" then out[#out + 1] = v:lower()
    elseif type(v) == "table" and depth < 3 then
        for _, x in pairs(v) do strs(x, out, depth + 1) end
    end
end
-- drop = objeto solto no Workspace, com ProximityPrompt, cujo nome/prompt indica a categoria
local function considerObj(o)
    if not Rec.on or not o.Parent or SKIP[o.Name] then return end
    if not (o:IsA("BasePart") or o:IsA("Model")) then return end
    if Players:GetPlayerFromCharacter(o) or o:FindFirstChildOfClass("Humanoid") then return end
    local prompts = promptsOf(o)
    if #prompts == 0 then return end
    local c = catOfText(o.Name)
    if not c then
        for _, pr in ipairs(prompts) do
            c = catOfText(tostring(pr.ActionText) .. " " .. tostring(pr.ObjectText))
            if c then break end
        end
    end
    if c then recHit(c, o.Name, o) end
end
local function recAdd(c) Rec.conns[#Rec.conns + 1] = c end

function Rec.start()
    recReset()
    Rec.on = true
    -- 1) drops que já estão no mapa + os que aparecerem
    for _, o in ipairs(workspace:GetChildren()) do task.spawn(considerObj, o) end
    recAdd(workspace.ChildAdded:Connect(function(o)
        task.delay(0.4, function() considerObj(o) end) -- espera o prompt nascer
    end))
    -- 2) avisos do jogo (presente / resgate)
    pcall(function()
        local n = 0
        for _, d in ipairs(RS:GetDescendants()) do
            if d:IsA("RemoteEvent") and n < 300 then
                n = n + 1
                local rname = d.Name:lower()
                recAdd(d.OnClientEvent:Connect(function(...)
                    pcall(function(...)
                        local parts, a = { rname }, { ... }
                        for i = 1, select("#", ...) do strs(a[i], parts, 0) end
                        local t = table.concat(parts, " ")
                        if hasWord(t, { "presente", "resgat", "ganhou", "recebeu", "gift", "drop" }) then
                            recHit(catOfText(t), nil, nil)
                        end
                    end, ...)
                end))
            end
        end
    end)
    -- 3) atributos do jogador (ex.: GamepassGiftCollects)
    pcall(function()
        recAdd(lp.AttributeChanged:Connect(function(n)
            local v, l = lp:GetAttribute(n), n:lower()
            if l:find("gift", 1, true) and type(v) == "number" and v >= 1 then
                recHit(l:find("gamepass", 1, true) and "Gamepass" or "UpPatente", n, "attr:" .. n)
            end
        end))
    end)
    -- 4) leaderstats / valores: dinheiro subindo, patente mudando
    pcall(function()
        for _, v in ipairs(lp:GetDescendants()) do
            if v:IsA("ValueBase") then
                local nm = v.Name:lower()
                local isMoneyV = hasWord(nm, MONEY_WORDS)
                local isRank = nm:find("patente", 1, true) or nm:find("rank", 1, true)
                if isMoneyV or isRank then
                    local old = v.Value
                    recAdd(v:GetPropertyChangedSignal("Value"):Connect(function()
                        local new = v.Value
                        local o = old
                        old = new
                        if isMoneyV then
                            local a = tonumber((tostring(new):gsub("[^%d]", "")))
                            local b = tonumber((tostring(o):gsub("[^%d]", "")))
                            if a and b and a > b then recHit("Dinheiro", v.Name, nil) end
                        elseif new ~= o then
                            recHit("UpPatente", v.Name, nil)
                        end
                    end))
                end
            end
        end
    end)
end
function Rec.stop()
    Rec.on = false
    for _, c in ipairs(Rec.conns) do pcall(function() c:Disconnect() end) end
    Rec.conns = {}
end
function Rec.namesOf(cat)
    local l = {}
    for n in pairs(Rec.hits[cat].names) do l[#l + 1] = n end
    table.sort(l)
    return l
end
function Rec.detected()
    local d = {}
    for _, c in ipairs(CAT_LIST) do
        if Rec.hits[c].n > 0 then d[c] = true end
    end
    return d
end

