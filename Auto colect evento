local farmToken = 0
local blacklist = {}

local function hrp()
    local c = lp.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function posOf(o)
    local p
    pcall(function() p = o:IsA("Model") and o:GetPivot().Position or o.Position end)
    return p
end
local function promptsOf(o)
    local l = {}
    for _, x in ipairs(o:GetDescendants()) do
        if x:IsA("ProximityPrompt") then l[#l + 1] = x end
    end
    return l
end

local MONEY_WORDS = { "moneybag", "money", "dinheiro", "cash", "grana" }
local function hasWord(str, words)
    str = tostring(str or ""):lower()
    for _, w in ipairs(words) do
        if str:find(w, 1, true) then return true end
    end
    return false
end
local function isMoney(o)
    if o:FindFirstChildOfClass("Humanoid") then return false end
    if hasWord(o.Name, MONEY_WORDS) then return true end
    for _, pr in ipairs(promptsOf(o)) do
        if hasWord(pr.ActionText, MONEY_WORDS) or hasWord(pr.ObjectText, MONEY_WORDS) then return true end
    end
    return false
end

local function sane(o)
    local p = posOf(o)
    return p ~= nil and p.X == p.X and p.Y == p.Y and p.Z == p.Z
        and math.abs(p.X) < 6000 and math.abs(p.Z) < 6000 and p.Y > -30 and p.Y < 600
end
local function hasActivePrompt(o)
    for _, pr in ipairs(promptsOf(o)) do
        if pr.Enabled then return true end
    end
    return false
end
local function suspect(o)
    return o:IsA("BasePart") and o.Anchored and o.Transparency >= 1 and not o.CanCollide
end

local SKIP = { Camera = true, Terrain = true, Map = true, Bullets = true, InvisiblePartsFolder = true }
local function listTargets(cat)
    local out = {}
    local names = CATS[cat]
    if not names or #names == 0 then return out end
    if cat ~= "Dinheiro" and giftTaken(cat) then return out end
    local now = os.clock()
    for _, o in ipairs(workspace:GetChildren()) do
        if (o:IsA("BasePart") or o:IsA("Model")) and not SKIP[o.Name] and (not blacklist[o] or blacklist[o] < now) then
            local ok = false
            for _, n in ipairs(names) do
                if o.Name == n then ok = true break end
            end
            if not ok and cat == "Dinheiro" and not Players:GetPlayerFromCharacter(o) then
                ok = isMoney(o)
            end
            if ok and sane(o) and hasActivePrompt(o) then
                out[#out + 1] = o
            end
        end
    end
    return out
end
local function sortByDist(l)
    local r = hrp()
    if not r then return l end
    table.sort(l, function(a, b)
        local pa, pb = posOf(a), posOf(b)
        return pa and pb and (pa - r.Position).Magnitude < (pb - r.Position).Magnitude or false
    end)
    return l
end

